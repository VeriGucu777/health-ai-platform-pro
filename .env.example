# Application
APP_NAME="Health AI Platform Pro"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8001
# Pilot: auth/clinical narrative rate limits are process-local — keep 1 worker when limits are on.
UVICORN_WORKERS=1

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/health_ai_platform
DATABASE_ECHO=false

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated origins (React web + React Native dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Observability
METRICS_ENABLED=false
SLOW_REQUEST_THRESHOLD_MS=1000
HEALTH_CHECK_DB_ENABLED=true
HEALTH_CHECK_DB_TIMEOUT_SECONDS=2

# Authentication rate limiting
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REFRESH_RATE_LIMIT=20
AUTH_REFRESH_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=60

# Rate limiting backend: memory (default) or redis
AUTH_RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# Clinical retrieval / RAG (set false on low-memory pilots e.g. Render Free 512MB)
# RAG_ENABLED=true

# Clinical retrieval embeddings (local ONNX — production/staging)
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=health-ai-platform/clinical-retrieval-multilingual-v1
# EMBEDDING_VERSION=3
# CLINICAL_RETRIEVAL_VECTOR_DIMENSION=384

# Clinical narrative LLM (v1)
CLINICAL_NARRATIVE_PROVIDER=fake
CLINICAL_NARRATIVE_DEFAULT_LANGUAGE=tr
CLINICAL_NARRATIVE_MAX_OUTPUT_TOKENS=800
CLINICAL_NARRATIVE_TIMEOUT_SECONDS=60
CLINICAL_NARRATIVE_MAX_RETRIES=1
CLINICAL_NARRATIVE_RATE_LIMIT_ENABLED=true
CLINICAL_NARRATIVE_RATE_LIMIT=10
CLINICAL_NARRATIVE_RATE_WINDOW_SECONDS=60
# External provider (production/staging — set in secret store, never commit)
# CLINICAL_NARRATIVE_PROVIDER=external
# CLINICAL_NARRATIVE_EXTERNAL_BASE_URL=https://api.openai.com/v1
# CLINICAL_NARRATIVE_EXTERNAL_MODEL=gpt-4o-mini
# CLINICAL_NARRATIVE_EXTERNAL_API_KEY=
# Live smoke gate (synthetic evidence only): CLINICAL_NARRATIVE_LIVE_SMOKE=1

# ---------------------------------------------------------------------------
# Production / Render (documentation only — set in Render dashboard)
# ---------------------------------------------------------------------------
# ENVIRONMENT=production
# DEBUG=false
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
#   Render may supply postgres:// or postgresql://; the app normalizes to
#   postgresql+asyncpg:// automatically without changing credentials or params.
# JWT_SECRET_KEY=<unique-secret-at-least-32-characters>
# CORS_ORIGINS=https://your-frontend.example.com
# AUTH_RATE_LIMIT_BACKEND=redis
# REDIS_URL=redis://your-redis-host:6379/0
# LOG_LEVEL=INFO
#
# Build command (Render):
#   pip install -r requirements.txt
#
# Pre-deploy / migration command (Render):
#   bash scripts/run_migrations.sh
#
# Start command (Render):
#   bash scripts/start_production.sh
#
# Health checks:
#   Liveness:  GET /api/v1/health
#   Readiness: GET /api/v1/ready
#   Readiness may return HTTP 503 when PostgreSQL is unavailable.
#
# Rollback:
#   1. Re-deploy the previous successful Render release.
#   2. If a migration must be reversed, run Alembic downgrade manually only
#      after confirming the target revision is safe for existing data.
#   3. Never commit real secrets to the repository.
