{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health-ai-platform.local/schemas/clinical_knowledge_source.schema.json",
  "title": "ClinicalKnowledgeSource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_type",
    "title",
    "publisher_or_organization",
    "edition_or_version",
    "publication_year",
    "official_url",
    "jurisdiction",
    "specialty",
    "topic_tags",
    "license_status",
    "ai_usage_status",
    "commercial_usage_status",
    "content_ingestion_allowed",
    "citation_required",
    "clinical_review_status"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9:_-]*$"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "guideline",
        "society_statement",
        "systematic_review",
        "peer_reviewed_article",
        "textbook",
        "licensed_database",
        "regulatory_source",
        "reimbursement_source",
        "national_guideline"
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "publisher_or_organization": { "type": "string", "minLength": 1, "maxLength": 256 },
    "edition_or_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "publication_year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
    "official_url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "jurisdiction": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "specialty": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "topic_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "license_status": {
      "type": "string",
      "enum": [
        "verified_open",
        "verified_commercial_allowed",
        "licensed",
        "internal_reference_only",
        "permission_required",
        "prohibited_for_ai_ingestion",
        "unknown"
      ]
    },
    "ai_usage_status": {
      "type": "string",
      "enum": ["allowed", "restricted", "prohibited", "unknown"]
    },
    "commercial_usage_status": {
      "type": "string",
      "enum": ["allowed", "restricted", "prohibited", "unknown"]
    },
    "content_ingestion_allowed": { "type": "boolean" },
    "citation_required": { "type": "boolean" },
    "clinical_review_status": {
      "type": "string",
      "enum": ["not_reviewed", "review_pending", "reviewed", "approved", "superseded"]
    },
    "publication_date": { "type": "string", "format": "date" },
    "effective_date": { "type": "string", "format": "date" },
    "superseded_date": { "type": "string", "format": "date" },
    "supersedes_source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:_-]*$"
    },
    "license_type": { "type": "string", "maxLength": 128 },
    "last_license_reviewed_at": { "type": "string", "format": "date-time" },
    "license_reviewed_by": { "type": "string", "maxLength": 128 },
    "last_clinically_reviewed_at": { "type": "string", "format": "date-time" }
  }
}
