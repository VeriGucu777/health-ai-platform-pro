# --- Option A: local FastAPI backend (default) ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001

# --- Option B: local UI + remote API (e.g. Render production) without CORS changes ---
# Browser calls http://localhost:3000/api/v1/*; Next rewrites to API_PROXY_TARGET.
# NEXT_PUBLIC_API_USE_DEV_PROXY=true
# API_PROXY_TARGET=https://your-backend.onrender.com
# NEXT_PUBLIC_API_BASE_URL=https://your-backend.onrender.com
